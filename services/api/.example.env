# Local non-Docker workflow only (ports 3000/3001). Root `.example.env` is canonical for Docker (copy to `.env` at repo root).
# Copy to .env before running the API (required)
SECRET_KEY=change-me-before-production
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
EMAIL_API_KEY=
FRONTEND_URL=http://localhost:3001
# PostgreSQL connection for inventory — copy exact URI from Supabase dashboard (project milestone5_inventory)
# Transaction pooler example (region/host varies — us-west-2 may use aws-1-us-west-2, not aws-0):
# DATABASE_URL=postgresql://postgres.[ref]:[url-encoded-password]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
TELEMETRY_ENDPOINT=http://localhost:8000/api/v1/telemetry/events

# RAG / knowledge assistant (4Geeks LiteLLM proxy)
LLM_BASE_URL=https://llm.4geeks.ai
LLM_API_KEY=
# Set true when llm.4geeks.ai presents a valid certificate
LLM_SSL_VERIFY=false
EMBEDDING_MODEL=downtown-miami/openrouter/perplexity/pplx-embed-v1-0.6b
GENERATION_MODEL=downtown-miami/openrouter/deepseek/deepseek-v4-flash
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=company_knowledge_base
RAG_TOP_K=3
RAG_MIN_SCORE=0.30
FEEDBACK_PATH=./data/eval/feedback.jsonl

# LangSmith tracing for LangGraph support agent (optional — leave key empty to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=healthcore-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Agent → company-tools MCP (Keycloak client_credentials; FastAPI JWT forwarded downstream)
MCP_COMPANY_TOOLS_URL=http://localhost:9000/mcp
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/healthcore/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=agent-support
KEYCLOAK_CLIENT_SECRET=agent-support-dev-secret

# Agent harness / guardrails (defaults on; kill-switch disables all four guard nodes)
GUARDRAILS_ENABLED=true
GUARDRAIL_CLASSIFIER_ENABLED=true
GUARDRAIL_PHI_DETECTION_ENABLED=true
GUARDRAIL_PREVIEW_MAX_CHARS=80

# Agent long-term memory (Redis system-of-record + Qdrant agent_memory collection)
MEMORY_ENABLED=true
REDIS_URL=redis://localhost:6379/0
MEMORY_QDRANT_COLLECTION=agent_memory
MEMORY_RECALL_K=5
MEMORY_ENTRY_TTL_DAYS=90
MEMORY_PENDING_TTL_MINUTES=30
MEMORY_MAX_ENTRIES_PER_SCOPE=50
MEMORY_DEDUPE_THRESHOLD=0.92
MEMORY_LOW_RELEVANCE_DAYS=30
MEMORY_SUMMARIZE_MIN_CLUSTER=3

# RFP drafting Phase 2 (empty model overrides → GENERATION_MODEL)
RFP_MAX_DRAFT_ITERATIONS=3
RFP_MAX_APPROVAL_ITERATIONS=3
RFP_READABILITY_MAX_GRADE=12
RFP_READABILITY_MAX_GRADE=12
RFP_GENERATOR_MODEL=
RFP_EVALUATOR_MODEL=
