{
  "realm": "healthcore",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "attributes": {
    "frontendUrl": "http://localhost:8080"
  },
  "users": [
    {
      "username": "coordinator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Coord",
      "lastName": "Inator",
      "email": "coordinator@healthcore.local",
      "credentials": [
        { "type": "password", "value": "coordinator", "temporary": false }
      ]
    },
    {
      "username": "readonly",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Read",
      "lastName": "Only",
      "email": "readonly@healthcore.local",
      "credentials": [
        { "type": "password", "value": "readonly", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "agent-support",
      "name": "LangGraph agent + MCP Inspector (dev only)",
      "enabled": true,
      "publicClient": false,
      "secret": "agent-support-dev-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "incidents:read",
        "inventory:read"
      ],
      "optionalClientScopes": [
        "offline_access",
        "incidents:write"
      ],
      "protocolMappers": [
        {
          "name": "sub-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-company-tools-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "company-tools-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "company-tools-mcp",
      "name": "MCP resource audience (placeholder client)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false
    }
  ],
  "clientScopes": [
    {
      "name": "incidents:read",
      "description": "Read incident tickets",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "incidents:write",
      "description": "Create and update incident tickets",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "inventory:read",
      "description": "Read inventory products",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ]
}
